# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Set your actual MongoDB Atlas cluster connection string here or use local Mongo instance
MONGODB_URI=mongodb://127.0.0.1:27017/linksnap

# JWT Secret (Min 32 characters recommended)
JWT_SECRET=super_secret_jwt_key_linksnap_2026_hackathon_token
JWT_EXPIRES_IN=7d

# App URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
